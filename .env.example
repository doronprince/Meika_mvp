# --- General ---
PROJECT_NAME="Meika AI Financial Copilot"
ENV="development"

# --- PostgreSQL (read by both docker-compose and the backend) ---
POSTGRES_USER=meika
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=meika
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full override; docker-compose builds this itself for the backend container.
# Set this when running the backend locally (outside Docker) against a local Postgres.
DATABASE_URL=postgresql+asyncpg://meika:change_me_locally@localhost:5432/meika

# --- CORS: comma-separated origins allowed to call the API ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- AI / XAI Copilot (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Auth (Phase 8) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app boots with an insecure dev default if unset — never rely on that
# outside local development.
JWT_SECRET_KEY=change_me_locally
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Rate limiting (in-memory, per-process — see [[rate-limit-scope]]) ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
